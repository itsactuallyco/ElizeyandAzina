# Cloudflare Pages cache rules.
# This file has no extension and must sit in the root of the repo, next to index.html.
#
# The problem it solves: browsers hang on to index.html and stories.json, so you
# publish a change and keep seeing the old version until you hard-refresh. The
# audio files never change once written, so those we let cache hard.

# The page and its content: always ask the server if there's a newer copy.
# "no-cache" does not mean "don't store" — it means "check first". The browser
# still gets a fast 304 Not Modified when nothing has changed.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/check.html
  Cache-Control: no-cache

/stories.json
  Cache-Control: no-cache

/audio/manifest.json
  Cache-Control: no-cache

# The MP3s are named by person and paragraph and only ever change when you
# re-record them, so cache them aggressively — this is what keeps the site
# feeling instant on a phone.
/audio/*
  Cache-Control: public, max-age=31536000

# Fonts and everything else: a day is plenty.
/*
  Cache-Control: public, max-age=86400
